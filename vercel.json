{
  "functions": {
    "api/chat.js": {
      "includeFiles": "course_knowledge_base_new.md"
    }
  },
  "rewrites": [
    {
      "source": "/micro",
      "destination": "https://micro-offer-funnel.vercel.app/micro"
    },
    {
      "source": "/micro/",
      "destination": "https://micro-offer-funnel.vercel.app/micro/"
    },
    {
      "source": "/micro/:path*",
      "destination": "https://micro-offer-funnel.vercel.app/micro/:path*"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!assets|favicon|vite).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ]
}
